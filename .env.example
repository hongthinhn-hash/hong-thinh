# Cau hinh may chu Website Song Khoe Moi Ngay Cung Hong Thinh
PORT=3000

# Khoa API Google Gemini (lay tai https://aistudio.google.com/apikey)
# TUYET DOI KHONG chia se file .env nay len mang hoac GitHub
GEMINI_API_KEY=

# Model Gemini su dung (mac dinh: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Mat khau dang nhap trang Quan tri (hay doi thanh mat khau manh cua rieng ban)
ADMIN_PASSWORD=HongThinh@2026

# Chuoi bi mat de ky phien dang nhap (nen doi thanh chuoi ngau nhien dai)
SESSION_SECRET=thay-doi-chuoi-bi-mat-nay-truoc-khi-trien-khai
